{
  "manifest_version": 3,
  "name": "Ecolution Job Scraper",
  "version": "1.0.0",
  "description": "Select job text on any job board and press Cmd+Shift+Y to send it to Ecolution.",
  "permissions": ["activeTab", "scripting", "notifications"],
  "host_permissions": ["https://api.kaleidoscopical.com/*", "http://localhost:3001/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "capture-job": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Capture selected job text"
    }
  },
  "action": { "default_title": "Ecolution Job Scraper (select text, Cmd+Shift+Y)" }
}
